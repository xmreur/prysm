<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.prysm.relay</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/prysm-relay</string>
		<string>serve</string>
		<string>--config</string>
		<string>/var/lib/prysm-relay/config.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- NB: several flags here must be comma-separated, not space-separated. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>DART_VM_OPTIONS</key>
		<string>--old_gen_heap_size=64</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/var/lib/prysm-relay</string>
	<key>StandardOutPath</key>
	<string>/var/log/prysm-relay.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/prysm-relay.err</string>
</dict>
</plist>
