             "own network namespace" if busy else "free"))

    if status == "running":
        probe = dexec(["python3", "/opt/lab/prysmlab", "status"])
        print("  info  in-container status:")
        for line in (probe.stdout or probe.stderr).splitlines():
            print(f"        {line}")
    return 0 if ok else 1


